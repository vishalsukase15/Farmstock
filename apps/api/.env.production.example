# ======================================================
# FARMSTOCK API — Production Environment Variables
# Copy these to Render → Environment tab
# ======================================================

# PostgreSQL connection string from Render Database
DATABASE_URL="postgresql://user:password@host/farmstock"

# Server
PORT=5000
NODE_ENV=production

# JWT Secrets — use long random strings (min 32 chars)
JWT_SECRET="replace-with-long-random-secret-min-32-chars"
REFRESH_SECRET="replace-with-another-long-random-secret"

# Frontend URL (your Vercel deployment URL — no trailing slash)
CLIENT_URL="https://farmstock.vercel.app"

# File uploads directory
UPLOAD_DIR="./uploads"

# Optional: Cloudinary (for persistent image storage)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
